{
  "name": "travel-camera-visualizer",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "A local-first cinematic travel route player for Google Timeline exports.",
  "scripts": {
    "start": "node server/index.mjs --production",
    "dev": "node server/index.mjs",
    "launch": "node scripts/launch-local.mjs",
    "launch:no-update": "node scripts/launch-local.mjs --no-update",
    "build": "tsc -b && vite build --config config/vite.config.ts",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src e2e server scripts config --max-warnings=0",
    "test": "vitest run --config config/vite.config.ts --coverage",
    "test:watch": "vitest --config config/vite.config.ts",
    "test:e2e": "playwright test --config config/playwright.config.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "map:setup": "node scripts/setup-local-map.mjs",
    "map:setup:force": "node scripts/setup-local-map.mjs --force",
    "prestart": "node scripts/ensure-build.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "5.3.0",
    "@protomaps/basemaps": "5.7.2",
    "lucide-react": "^1.37.0",
    "maplibre-gl": "6.6.0",
    "pmtiles": "4.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "24.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}

{
  "name": "travel-camera-visualizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Travel timeline visualizer with distance/speed-aware mobility inference and globally smoothed camera trajectories.",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test",
    "timeline:setup": "node scripts/setup-timeline.mjs",
    "map:setup": "node scripts/setup-local-map.mjs",
    "map:setup:force": "node scripts/setup-local-map.mjs --force"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@protomaps/basemaps": "5.7.2",
    "maplibre-gl": "5.6.1",
    "pmtiles": "4.5.0"
  }
}

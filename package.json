{
  "name": "travel-camera-visualizer",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A local-first cinematic travel route player for Google Timeline exports.",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src e2e --max-warnings=0",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "map:setup": "node scripts/setup-local-map.mjs",
    "map:setup:force": "node scripts/setup-local-map.mjs --force"
  },
  "engines": { "node": ">=24" },
  "license": "MIT",
  "dependencies": {
    "@protomaps/basemaps": "5.7.2",
    "lucide-react": "1.35.0",
    "maplibre-gl": "6.6.0",
    "pmtiles": "4.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react-swc": "4.3.3",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.35.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
